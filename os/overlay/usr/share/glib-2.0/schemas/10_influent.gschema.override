[org.gnome.desktop.interface]
color-scheme='prefer-dark'
gtk-theme='Yaru-dark'
icon-theme='Yaru'
font-name='Ubuntu 11'

[org.gnome.desktop.wm.preferences]
theme='Yaru-dark'

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/influent/influent.svg'
picture-uri-dark='file:///usr/share/backgrounds/influent/influent.svg'
primary-color='#2C001E'
secondary-color='#E95420'

[org.gnome.shell]
enable-hot-corners=false
favorite-apps=['org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop', 'firefox.desktop', 'influent-apps.desktop']
