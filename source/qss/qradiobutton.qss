/* Radio UWP: círculo gris en reposo, hover relleno de acento y pressed con el
   borde más grueso creciendo hacia dentro (conserva el color del hover). */

QRadioButton {
    color: __TEXT_MUTED__;
    font-family: __FONT_STACK__;
    font-size: 13px;
    spacing: 8px;
    background: transparent;
}
QRadioButton::indicator {
    width: 18px; height: 18px;
    border-radius: 10px;
    border: 2px solid __TEXT_DIM__;
    background: transparent;
}
QRadioButton::indicator:hover {
    border-color: __ACCENT__;
    background: __ACCENT__;
}
QRadioButton::indicator:pressed {
    border: 3px solid __ACCENT__;
    background: __ACCENT__;
}
QRadioButton::indicator:checked {
    border: 5px solid __ACCENT__;
    background: __SURFACE__;
}
QRadioButton::indicator:checked:hover {
    border-color: __ACCENT_HOVER__;
}
QRadioButton::indicator:checked:pressed {
    border: 6px solid __ACCENT_HOVER__;
}
QRadioButton::indicator:disabled {
    border-color: __TEXT_FAINT__;
    background: transparent;
}
QRadioButton:disabled { color: __TEXT_FAINT__; }
